# Anthropic API key for the three managed agents
ANTHROPIC_API_KEY=

# ----- Polymarket US (the regulated entity — API key pair, NO funder address) -----
# pip/uv install polymarket-us. Read endpoints work without creds; orders need both.
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=

# ----- Polymarket on-chain CLOB (DIFFERENT product; wallet-signed) -----
# Required only when PAPER_TRADING=false.
# Per docs.polymarket.com (2026-05-13), POLY_1271 (signature_type=3) is the
# recommended flow for new users with a deposit wallet.

# The EOA private key that signs orders (32-byte hex, no 0x prefix accepted by py-clob-client)
POLYMARKET_PRIVATE_KEY=

# The address that HOLDS your collateral. For signature_type=3 this is your
# deposit wallet address (distinct from the signer's EOA).
POLYMARKET_FUNDER_ADDRESS=

# Signature type: 1=POLY_PROXY (Magic Link), 2=GNOSIS_SAFE, 3=POLY_1271 (deposit wallet, default)
POLYMARKET_SIGNATURE_TYPE=3

# Chain ID for Polygon mainnet
POLYMARKET_CHAIN_ID=137

# CLOB REST host (override only for a sandbox if Polymarket offers one)
POLYMARKET_CLOB_HOST=https://clob.polymarket.com

# ----- SEC EDGAR (free fundamentals — no key, but a contact IS required) -----
# SEC 403s any caller that does not declare itself. Format: "App Name email".
# Without this, Altman/Piotroski report NOT AVAILABLE.
SEC_USER_AGENT=Lazy Polymarket Trader your@email.com

# ----- Gemini failover -----
# The fund uses ANTHROPIC_API_KEY (pay-per-token, NO session limit). It fails
# over to Gemini when Anthropic rate-limit headroom drops below 15% remaining
# (85% consumed) or on a 429, and switches back when the window resets.
# Either set a key here, or `npm i -g @google/gemini-cli` and authenticate it.
# The key path is preferred: the CLI costs a subprocess per call, and the round
# table makes 7 calls per candidate.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest   # Pro models have zero free-tier quota

# ----- Market data (the hedge fund) -----
# Massive — https://massive.com. Stocks plan + fundamentals add-on.
#
# NOTE: the `massive` MCP server is a SEPARATE channel. That one is authenticated
# per Claude Code session and is used for exploring the API. The fund runs as its
# own process and cannot reach it, so it needs this key to fetch anything.
MASSIVE_API_KEY=

# ----- Fund overrides (optional; config/fund.toml holds the defaults) -----
# Anything set here WINS over the TOML file. Leave blank to use the file.
# Leave the equity watchlist EMPTY (the default) and the scout screens the whole
# US tape each cycle — ~12,500 tickers filtered down to a shortlist by liquidity
# and momentum before any LLM is involved. Set it only to pin the fund to
# specific names, which overrides discovery.
# FUND_EQUITY_WATCHLIST=
# FUND_CRYPTO_WATCHLIST=BTC,ETH
# Bankroll follows the live wallet balance each cycle; this is only a fallback
# for before the first account read.
# FUND_BANKROLL_USD=
# FUND_ACCOUNT_EQUITY_USD=
# FUND_MAX_DAILY_LOSS_USD=
# FUND_DATA_PROVIDER=massive

# ----- Trading gates -----
# Default to paper-trading. Set to false ONLY when all of:
#   1. POLYMARKET_PRIVATE_KEY + POLYMARKET_FUNDER_ADDRESS are filled in
#   2. Risk caps in verification/criteria.py have been tightened for live size
#   3. Outcome Grader has validated >50 paper trades on the active strategy
#   4. User has explicitly confirmed in-session (CLAUDE.md rule #4)
PAPER_TRADING=true

# ----- Local memory -----
MEMORY_DB_PATH=./memory/state.db

# --- Telegram fill notifications (optional) ---------------------------------
# A message per FILL: symbol, side, size, price, and — on an exit — the reason
# and realised result. Absent, the notifier is simply off.
#
# The token is a BEARER CREDENTIAL: anyone holding it can post as your bot. It
# is never logged and is redacted in repr, but treat it like a password.
#   1. Talk to @BotFather on Telegram, /newbot, copy the token.
#   2. Message your new bot once, then open
#      https://api.telegram.org/bot<TOKEN>/getUpdates to read your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- optional signal sources -------------------------------------------
# Financial Modeling Prep (free tier). ONE key unlocks three gated sources:
# the earnings calendar, the economic calendar, and disclosed STOCK Act trades
# by tracked officials. Without it those degrade to a stated reason.
FMP_API_KEY=

# Reddit OAuth (free). Reddit's public JSON returns 403 now, so the social
# sentiment feed needs a registered client: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
