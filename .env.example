# Anthropic API key for the three managed agents
ANTHROPIC_API_KEY=

# ----- Polymarket wallet -----
# Required only when PAPER_TRADING=false.
# Per docs.polymarket.com (2026-05-13), POLY_1271 (signature_type=3) is the
# recommended flow for new users with a deposit wallet.

# The EOA private key that signs orders (32-byte hex, no 0x prefix accepted by py-clob-client)
POLYMARKET_PRIVATE_KEY=

# The address that HOLDS your collateral. For signature_type=3 this is your
# deposit wallet address (distinct from the signer's EOA).
POLYMARKET_FUNDER_ADDRESS=

# Signature type: 1=POLY_PROXY (Magic Link), 2=GNOSIS_SAFE, 3=POLY_1271 (deposit wallet, default)
POLYMARKET_SIGNATURE_TYPE=3

# Chain ID for Polygon mainnet
POLYMARKET_CHAIN_ID=137

# CLOB REST host (override only for a sandbox if Polymarket offers one)
POLYMARKET_CLOB_HOST=https://clob.polymarket.com

# ----- Market data (the hedge fund) -----
# Massive — https://massive.com. Stocks plan + fundamentals add-on.
#
# NOTE: the `massive` MCP server is a SEPARATE channel. That one is authenticated
# per Claude Code session and is used for exploring the API. The fund runs as its
# own process and cannot reach it, so it needs this key to fetch anything.
MASSIVE_API_KEY=

# ----- Fund overrides (optional; config/fund.toml holds the defaults) -----
# Anything set here WINS over the TOML file. Leave blank to use the file.
# FUND_EQUITY_WATCHLIST=AAPL,MSFT,NVDA
# FUND_CRYPTO_WATCHLIST=BTC,ETH
# FUND_BANKROLL_USD=
# FUND_ACCOUNT_EQUITY_USD=
# FUND_MAX_DAILY_LOSS_USD=
# FUND_DATA_PROVIDER=massive

# ----- Trading gates -----
# Default to paper-trading. Set to false ONLY when all of:
#   1. POLYMARKET_PRIVATE_KEY + POLYMARKET_FUNDER_ADDRESS are filled in
#   2. Risk caps in verification/criteria.py have been tightened for live size
#   3. Outcome Grader has validated >50 paper trades on the active strategy
#   4. User has explicitly confirmed in-session (CLAUDE.md rule #4)
PAPER_TRADING=true

# ----- Local memory -----
MEMORY_DB_PATH=./memory/state.db
