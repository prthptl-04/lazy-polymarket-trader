# Anthropic API key for the three managed agents
ANTHROPIC_API_KEY=

# Polymarket wallet — only needed when PAPER_TRADING=false
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_CLOB_HOST=https://clob.polymarket.com

# Default to paper-trading. Set to false ONLY after Outcome Grader has validated a strategy.
PAPER_TRADING=true

# Local SQLite path for cross-session memory
MEMORY_DB_PATH=./memory/state.db
